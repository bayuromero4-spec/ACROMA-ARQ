---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WhyUs from '../components/WhyUs.astro';
import CtaBand from '../components/CtaBand.astro';
import teamPhoto from '../assets/equipo-tecnico-acroma.png';
import { team, values } from '../data/site';
import { breadcrumbSchema } from '../lib/seo';
import { getBusiness, getSiteImages } from '../lib/content';

const business = await getBusiness();
const teamOverride = (await getSiteImages()).nosotros;
const site = Astro.site!.toString().replace(/\/$/, '');
---

<BaseLayout
  title="Nosotros, arquitectos en Cajamarca"
  description="Conoce a ACROMA Arquitectos: equipo de arquitectos en Cajamarca que diseña y construye viviendas, reformas y edificios con un proceso claro y cercano."
  path="/nosotros"
  ogImage={`${site}${teamPhoto.src}`}
  schema={breadcrumbSchema(site, [{ name: 'Inicio', href: '/' }, { name: 'Nosotros', href: '/nosotros' }])}
>
  <PageHero
    eyebrow="Nosotros"
    title="Arquitectura clara para decisiones importantes."
    lead="Somos un estudio de arquitectura y construcción con base en Cajamarca. Trabajamos de cerca con cada cliente para que entienda, decida y construya con confianza."
    breadcrumbs={[{ name: 'Nosotros' }]}
  />

  <section class="section aurora" aria-labelledby="story-title">
    <div class="container story">
      <div>
        <p class="eyebrow">El estudio</p>
        <h2 id="story-title">Diseñamos para la vida diaria, no solo para la fotografía.</h2>
      </div>
      <div class="story__text" data-reveal>
        <p class="lead">
          ACROMA nació de una convicción sencilla: la mayoría de los problemas de una obra se evitan antes de empezarla.
          Por eso dedicamos tiempo a escuchar, medir y planificar.
        </p>
        <p>
          Diseñamos viviendas, edificios pequeños y reformas pensando en el terreno, el clima de la sierra y el
          presupuesto real de cada familia. Elaboramos los planos de todas las especialidades y, cuando el cliente lo
          necesita, ejecutamos la obra con el mismo equipo que la diseñó.
        </p>
        <p>
          Te explicamos cada decisión con lenguaje simple: orientación, ventilación, recorridos, áreas, etapas y
          prioridades. La meta es que sepas qué estás aprobando y por qué.
        </p>
      </div>
    </div>
  </section>

  <section class="section aurora" aria-labelledby="team-title">
    <div class="container team">
      <div class="team__photo" data-reveal="left">
        {
          teamOverride ? (
            <img src={teamOverride.url} alt={teamOverride.alt || 'Equipo técnico de ACROMA Arquitectos'} loading="lazy" decoding="async" />
          ) : (
            <Image
              src={teamPhoto}
              alt="Equipo técnico de ACROMA Arquitectos: dos arquitectos en retrato de estudio"
              widths={[480, 800, 1100]}
              sizes="(min-width: 980px) 520px, 100vw"
              loading="lazy"
            />
          )
        }
      </div>
      <div>
        <p class="eyebrow">Equipo técnico</p>
        <h2 id="team-title">Las personas detrás de cada proyecto.</h2>
        <ul class="team__list" role="list">
          {
            team.map((m) => (
              <li>
                <p class="team__role">{m.role}</p>
                <h3>{m.name}</h3>
                <p>{m.bio}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section aurora" aria-labelledby="values-title">
    <div class="container">
      <div class="section-head section-head--stack" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 id="values-title">Tres principios que guían cada proyecto.</h2>
      </div>
      <ul class="values" role="list" data-reveal-group="130">
        {
          values.map((v) => (
            <li class="glass" data-glass>
              <h3>{v.title}</h3>
              <p>{v.description}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <WhyUs />

  <section class="section section--dark aurora aurora--dark" aria-labelledby="area-title">
    <div class="container area">
      <div>
        <p class="eyebrow">Dónde trabajamos</p>
        <h2 id="area-title">Cajamarca y asesoría online para todo el Perú.</h2>
      </div>
      <p class="lead">
        Atendemos proyectos presenciales en Cajamarca y sus provincias. Si estás en otra región, podemos acompañarte con
        asesoría, diseño y planos a distancia. Horario de atención: {business.hours.toLowerCase()}.
      </p>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 84px);
    align-items: start;
  }
  .story__text {
    display: grid;
    gap: 20px;
  }
  .story__text p:not(.lead) {
    line-height: 1.8;
    color: var(--soft-ink);
  }
  .team {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(32px, 6vw, 84px);
    align-items: center;
  }
  .team__photo {
    overflow: hidden;
    border-radius: 36px;
    background: #101116;
    box-shadow: var(--shadow);
  }
  .team__photo :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
  .team__list {
    display: grid;
    margin-top: 30px;
  }
  .team__list li {
    padding: 26px 0;
    border-top: 1px solid var(--line);
  }
  .team__list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .team__role {
    font-family: var(--font-label);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 8px;
  }
  .team__list h3 {
    font-size: 1.7rem;
    margin-bottom: 8px;
  }
  .team__list li > p:last-child {
    line-height: 1.7;
    color: var(--soft-ink);
  }
  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .values li {
    --radius-lg: 28px;
    padding: 34px;
  }
  .values h3 {
    margin-bottom: 12px;
  }
  .values p {
    line-height: 1.7;
    color: var(--soft-ink);
  }
  .area {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 28px clamp(32px, 6vw, 84px);
    align-items: end;
  }
  @media (max-width: 900px) {
    .story,
    .team,
    .area {
      grid-template-columns: 1fr;
    }
    .values {
      grid-template-columns: 1fr;
    }
    .team__photo {
      max-width: 560px;
    }
  }
</style>
