---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PostCard from '../../components/PostCard.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getAllPosts, getBusiness, getPostBySlug, getPosts } from '../../lib/content';
import { formatDay, kindLabel, socialName } from '../../lib/format';
import { breadcrumbSchema, postSchema } from '../../lib/seo';

export async function getStaticPaths() {
  return (await getAllPosts()).map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);
if (!post) return Astro.redirect('/404');

const business = await getBusiness();
const others = (await getPosts()).filter((p) => p.slug !== post.slug).slice(0, 3);
const site = Astro.site!.toString().replace(/\/$/, '');
const path = `/novedades/${post.slug}`;
const today = new Date().toISOString().slice(0, 10);
const expired = !!post.endsOn && post.endsOn < today;
---

<BaseLayout
  title={post.title}
  description={post.summary || post.title}
  path={path}
  ogImage={post.image?.src}
  ogType="article"
  schema={[
    postSchema(site, post),
    breadcrumbSchema(site, [
      { name: 'Inicio', href: '/' },
      { name: 'Novedades', href: '/novedades' },
      { name: post.title, href: path },
    ]),
  ]}
>
  <PageHero
    eyebrow={`${kindLabel(post.kind)} · ${formatDay(post.startsOn)}`}
    title={post.title}
    lead={post.summary}
    breadcrumbs={[{ name: 'Novedades', href: '/novedades' }, { name: post.title }]}
  />

  <article class="section aurora">
    <div class="container post">
      {post.image && <img class="post__img" src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} decoding="async" />}
      {expired && <p class="post__expired">Esta campaña ya finalizó. Escríbenos para conocer las promociones vigentes.</p>}
      {!expired && post.endsOn && post.kind === 'campana' && <p class="post__until">Vigente hasta el {formatDay(post.endsOn)}</p>}
      <div class="post__body">
        {post.body.map((p) => <p>{p}</p>)}
      </div>
      <div class="post__actions">
        {post.ctaUrl && !expired && <a class="btn btn--gold" href={post.ctaUrl}>{post.ctaLabel || 'Más información'}</a>}
        {post.socialUrl && <a class="btn btn--outline-dark" href={post.socialUrl} target="_blank" rel="noopener noreferrer">Ver en {socialName(post.socialUrl)}</a>}
      </div>
      <div class="post__follow">
        <SocialLinks facebook={business.social.facebook} instagram={business.social.instagram} />
      </div>
    </div>
  </article>

  {
    others.length > 0 && (
      <section class="section aurora" aria-labelledby="more-title">
        <div class="container">
          <h2 id="more-title" class="more-title">Más novedades</h2>
          <ul class="grid" role="list">
            {others.map((p) => <li><PostCard post={p} /></li>)}
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .post {
    max-width: 820px;
  }
  .post__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 60px rgba(20, 35, 60, 0.18);
    margin-bottom: 32px;
  }
  .post__until,
  .post__expired {
    display: inline-block;
    margin-bottom: 20px;
    padding: 8px 16px;
    border-radius: 99px;
    background: rgba(189, 152, 80, 0.16);
    font-weight: 700;
    color: var(--gold-ink);
  }
  .post__expired {
    background: rgba(179, 38, 30, 0.1);
    color: #8c1d18;
  }
  .post__body {
    display: grid;
    gap: 18px;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--soft-ink);
  }
  .post__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .post__follow {
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .more-title {
    margin-bottom: 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  @media (max-width: 980px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
