---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getProjects } from '../../lib/content';
import { breadcrumbSchema } from '../../lib/seo';

const projects = await getProjects();
const categories = [...new Set(projects.map((p) => p.category))];
const site = Astro.site!.toString().replace(/\/$/, '');
---
<BaseLayout title="Proyectos de arquitectura y reformas" description="Explora proyectos realizados, propuestas en diseño y desarrollo y experiencias arquitectónicas 360° de ACROMA Arquitectos." path="/proyectos" schema={breadcrumbSchema(site, [{ name: 'Inicio', href: '/' }, { name: 'Proyectos', href: '/proyectos' }])}>
  <PageHero eyebrow="Portafolio ACROMA" title="Ideas que toman forma. Espacios que se pueden recorrer." lead="Conoce nuestro trabajo: proyectos realizados, propuestas en desarrollo y experiencias inmersivas en 360°." breadcrumbs={[{ name: 'Proyectos' }]} />
  <section class="section aurora"><div class="container">
    <div class="section-intro"><p class="eyebrow">01 · PORTAFOLIO</p><h2>Proyectos realizados</h2><p>Obras y encargos concluidos que forman parte de nuestra experiencia.</p></div>
    <div class="filters" role="group" aria-label="Filtrar por categoría" data-filters><button type="button" class="chip" aria-pressed="true" data-filter="all">Todos</button>{categories.map((c) => <button type="button" class="chip" aria-pressed="false" data-filter={c}>{c}</button>)}</div>
    <ul class="grid" role="list" data-grid data-reveal-group="100">{projects.map((p,i)=><li data-category={p.category}><ProjectCard project={p} eager={i<3}/></li>)}</ul>
    <p class="empty" data-empty hidden>No hay proyectos en esta categoría por ahora.</p><div class="public-grid" id="completed-hub-grid" aria-label="Otros proyectos realizados"></div>
  </div></section>
  <section class="section" id="developing-projects"><div class="container"><div class="section-intro"><p class="eyebrow">02 · EN PROCESO</p><h2>En diseño y desarrollo</h2><p>Proyectos que están tomando forma. Compartimos únicamente los encargos habilitados para publicación por ACROMA.</p></div><div class="public-grid" id="developing-grid"><p class="public-state">Cargando proyectos…</p></div></div></section>
  <section class="section aurora" id="360-experiences"><div class="container"><div class="section-intro"><p class="eyebrow">03 · EXPERIENCIA INMERSIVA</p><h2>Recorridos 360°</h2><p>Explora ambientes y propuestas arquitectónicas desde una perspectiva inmersiva.</p></div><div class="public-grid" id="experience-grid"><p class="public-state">Cargando experiencias…</p></div></div></section>
  <CtaBand title="¿Tienes un proyecto en mente?" text="Cuéntanos tu idea y te orientaremos sobre cómo convertirla en un proyecto arquitectónico viable." />
</BaseLayout>
<style>
.section-intro{max-width:760px;margin:0 0 34px}.section-intro h2{font-size:clamp(1.8rem,3.5vw,2.8rem);color:var(--navy);margin:8px 0 10px}.section-intro>p:last-child{color:var(--muted);line-height:1.7}.filters{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:clamp(28px,4vw,46px)}.chip{min-height:44px;padding:0 20px;border:1px solid rgba(255,255,255,.85);border-radius:999px;background:linear-gradient(135deg,rgba(255,255,255,.7),rgba(255,255,255,.36));backdrop-filter:blur(14px) saturate(170%);box-shadow:inset 0 1px 0 #fff,0 6px 18px rgba(20,35,60,.08);color:var(--navy);font:500 .92rem var(--font-body);cursor:pointer;transition:background .3s var(--ease),color .3s var(--ease),transform .35s var(--ease-out)}.chip:active{transform:scale(.96)}.chip[aria-pressed=true]{background:linear-gradient(180deg,#25406a,#14233c);border-color:transparent;color:var(--white);box-shadow:inset 0 1px 0 rgba(255,255,255,.3),0 10px 26px rgba(20,35,60,.3)}.grid,.public-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:36px 26px}.grid li[hidden]{display:none}.empty,.public-state{margin-top:20px;color:var(--muted);grid-column:1/-1}.public-card{overflow:hidden;border-radius:var(--radius-lg);background:#14233c;box-shadow:var(--shadow);min-width:0}.public-card>a{display:block;color:inherit;text-decoration:none}.public-card__image{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;background:#d8dce3}.public-card__body{padding:20px;color:#fff}.public-card__eyebrow{font:700 .7rem var(--font-label);letter-spacing:.16em;text-transform:uppercase;color:#dfc17d}.public-card h3{font-size:1.25rem;margin:7px 0}.public-card p{color:#d7dfeb;line-height:1.6;font-size:.92rem}.public-card__actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:16px}.public-card__actions span{border-radius:999px;padding:10px 15px;background:#ffffff16;border:1px solid #ffffff50;color:white;font-weight:700;font-size:.82rem}@media(max-width:980px){.grid,.public-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:640px){.grid,.public-grid{grid-template-columns:1fr;gap:28px}}
</style>
<script>
import { createClient } from '@supabase/supabase-js';
import { SUPABASE_URL, SUPABASE_KEY, hasSupabase } from '../../lib/supabase';
const filters=document.querySelector('[data-filters]'),items=document.querySelectorAll<HTMLElement>('[data-grid] > li'),empty=document.querySelector<HTMLElement>('[data-empty]');
filters?.addEventListener('click',(event)=>{const button=(event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');if(!button)return;const value=button.dataset.filter;filters.querySelectorAll('[data-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));let visible=0;items.forEach(li=>{const show=value==='all'||li.dataset.category===value;li.hidden=!show;if(show)visible++});if(empty)empty.hidden=visible>0});
const developing=document.getElementById('developing-grid'),experiences=document.getElementById('experience-grid'),completed=document.getElementById('completed-hub-grid');
const esc=(v:string)=>String(v||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]!));
const stageLabel=(v:string)=>({design:'En diseño',development:'En desarrollo',construction:'En construcción',completed:'Finalizado'}[v]||'Proyecto ACROMA');
if(hasSupabase&&developing&&experiences){
 const sb=createClient(SUPABASE_URL,SUPABASE_KEY);
 const load=async()=>{const [{data:pubs,error:pErr},{data:tours,error:tErr}]=await Promise.all([sb.from('hub_project_publications').select('project_id,slug,public_title,public_category,public_location,public_stage,excerpt,cover_url,show_360,featured').eq('is_published',true).order('featured',{ascending:false}).order('updated_at',{ascending:false}),sb.from('hub_project_tours').select('project_id,slug,title,intro').eq('status','published')]);if(pErr)throw pErr;if(tErr)throw tErr;const publications=pubs||[],tourList=tours||[];
 const card=(p:any,t:any|null,experience=false)=>'<article class="public-card"><a href="'+(t?'/recorrido/?tour='+encodeURIComponent(t.slug):'/contacto#formulario')+'"><img class="public-card__image" src="'+esc(p.cover_url||'/og-default.jpg')+'" alt="'+esc(p.public_title)+'" loading="lazy"><div class="public-card__body"><span class="public-card__eyebrow">'+esc(experience?'EXPERIENCIA 360°':stageLabel(p.public_stage)+' · '+p.public_category)+'</span><h3>'+esc(p.public_title)+'</h3><p>'+esc(experience?(t.intro||p.excerpt||'Explora este proyecto en un recorrido virtual.'):p.excerpt||p.public_location)+'</p><div class="public-card__actions"><span>'+(experience?'Iniciar recorrido 360° ↗':t?'Ver experiencia 360° ↗':'Consultar proyecto ↗')+'</span></div></div></a></article>';
 const inProgress=publications.filter(p=>p.public_stage!=='completed'),finished=publications.filter(p=>p.public_stage==='completed'),tourCards=publications.filter(p=>p.show_360).map(p=>({p,t:tourList.find(t=>t.project_id===p.project_id)})).filter(x=>x.t);
 developing.innerHTML=inProgress.length?inProgress.map(p=>card(p,tourList.find(t=>t.project_id===p.project_id)||null)).join(''):'<p class="public-state">Próximamente compartiremos nuevos proyectos en diseño y desarrollo.</p>';if(completed)completed.innerHTML=finished.map(p=>card(p,tourList.find(t=>t.project_id===p.project_id)||null)).join('');
 experiences.innerHTML=tourCards.length?tourCards.map(x=>card(x.p,x.t,true)).join(''):'<p class="public-state">Estamos preparando nuevas experiencias 360°.</p>';};
 load().catch(error=>{console.warn('No se pudo cargar el portafolio unificado',error);developing.innerHTML='<p class="public-state">No fue posible cargar los proyectos en este momento.</p>';experiences.innerHTML='<p class="public-state">No fue posible cargar las experiencias 360°.</p>';});
}else{if(developing)developing.innerHTML='<p class="public-state">Próximamente compartiremos nuevos proyectos en diseño y desarrollo.</p>';if(experiences)experiences.innerHTML='<p class="public-state">Estamos preparando nuevas experiencias 360°.</p>';}
</script>
