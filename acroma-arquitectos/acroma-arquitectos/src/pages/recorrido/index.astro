---
import { SUPABASE_URL, SUPABASE_KEY, hasSupabase } from '../../lib/supabase';
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101c32"/><title>Recorrido 360° · ACROMA</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<style>*{box-sizing:border-box}body{margin:0;background:#0b1423;color:#fff;font-family:Inter,system-ui,sans-serif}.top{height:66px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#101c32;border-bottom:1px solid #ffffff20}.brand{font-size:12px;letter-spacing:.18em}.brand b{color:#d4b36b}.top a{color:#fff;text-decoration:none;font-size:13px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;height:calc(100dvh - 66px)}.main{position:relative;min-width:0}.viewer{position:absolute;inset:0}.overlay{position:absolute;z-index:5;left:24px;top:20px;pointer-events:none;text-shadow:0 2px 12px #000}.eyebrow{font-size:10px;letter-spacing:.2em;color:#e2c17c}.overlay h1{font-size:clamp(22px,3vw,34px);margin:8px 0}.overlay p{color:#e0e4ea;margin:0;font-size:13px}.controls{position:absolute;z-index:6;bottom:20px;left:50%;transform:translateX(-50%);display:flex;gap:8px;flex-wrap:wrap;justify-content:center;width:max-content;max-width:95%}.controls button,.floor{border:1px solid #ffffff30;background:#101c32e8;color:#fff;border-radius:999px;padding:10px 14px;cursor:pointer;backdrop-filter:blur(12px)}.side{background:#111f34;border-left:1px solid #ffffff18;padding:18px;overflow:auto}.side h2{font-size:16px;margin:0 0 6px}.muted{font-size:12px;color:#9ba9bb;line-height:1.5}.floor{margin:12px 5px 8px 0}.floor.active{background:#c7a45f;color:#142238;border-color:#c7a45f}.plan{position:relative;background:#f3f5f8;border-radius:12px;overflow:hidden;margin:12px 0}.plan img{display:block;width:100%;max-height:260px;object-fit:contain}.marker{position:absolute;transform:translate(-50%,-50%);width:27px;height:27px;border:2px solid #fff;border-radius:50%;background:#c6a35b;color:#142238;font-weight:800;font-size:11px;cursor:pointer;box-shadow:0 2px 10px #0005}.marker.active{background:#172944;color:white;outline:2px solid #c6a35b}.scene{display:flex;gap:10px;padding:9px;border-radius:11px;cursor:pointer;border:1px solid transparent;margin:5px 0}.scene.active{background:#ffffff12;border-color:#c7a45f80}.scene img{width:74px;height:58px;object-fit:cover;border-radius:8px}.scene strong{font-size:13px;display:block;margin:4px 0}.scene small{color:#9ba9bb}.connections{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0}.connections button{background:#ffffff10;border:1px solid #ffffff20;color:#e8d4a8;border-radius:30px;padding:7px 10px;font-size:11px;cursor:pointer}.empty{padding:28px;text-align:center;color:#c4ccd6}.loader{position:absolute;inset:0;display:grid;place-items:center;background:#0b1423;z-index:10;color:#d6bd87}@media(max-width:760px){.top{height:58px;padding:0 16px}.layout{display:flex;flex-direction:column;height:calc(100dvh - 58px)}.main{height:54dvh;min-height:340px;flex:none}.side{flex:1;border-left:0;border-top:1px solid #ffffff18;padding:14px}.overlay{left:15px;top:12px}.overlay p{max-width:75vw}.controls{bottom:10px}.plan img{max-height:190px}}</style></head>
<body data-url={hasSupabase ? SUPABASE_URL : ''} data-key={hasSupabase ? SUPABASE_KEY : ''}><header class="top"><div class="brand">ACROMA <b>360 EXPERIENCE</b></div><a href="/proyectos">Ver proyectos ↗</a></header>
<div class="layout"><main class="main"><div id="viewer" class="viewer"></div><div class="overlay"><div class="eyebrow">RECORRIDO ARQUITECTÓNICO · 360°</div><h1 id="title">Preparando experiencia…</h1><p id="desc"></p></div><div class="controls"><button id="auto">▶ Giro automático</button><button id="fullscreen">⛶ Pantalla completa</button><button id="reset">◎ Restablecer vista</button></div><div id="loader" class="loader">Cargando recorrido…</div></main>
<aside class="side"><h2>Plano interactivo</h2><p class="muted">Selecciona un marcador en la planta o un ambiente para recorrer el proyecto.</p><div id="floors"></div><div id="plan" class="plan"></div><div id="connections" class="connections"></div><div id="scenes"></div><div id="empty" class="empty" hidden>Este recorrido todavía no tiene ambientes publicados.</div></aside></div>
<script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script><script>
import { createClient } from '@supabase/supabase-js';
const sb=createClient(document.body.dataset.url||'',document.body.dataset.key||''),slug=new URLSearchParams(location.search).get('tour');let scenes=[],plans=[],viewer=null,current=null,auto=false,activeFloor=null;
const $=id=>document.getElementById(id),esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function boot(){if(!slug)throw Error('Enlace de recorrido incompleto.');const {data:tour,error}=await sb.from('hub_project_tours').select('id,title,intro,status').eq('slug',slug).eq('status','published').maybeSingle();if(error||!tour)throw Error('Este recorrido no está disponible.');const [s,p]=await Promise.all([sb.from('hub_project_tour_scenes').select('*').eq('tour_id',tour.id).order('sort_order'),sb.from('hub_project_tour_plans').select('*').eq('tour_id',tour.id).order('sort_order')]);if(s.error)throw s.error;if(p.error)throw p.error;scenes=s.data||[];plans=p.data||[];$('title').textContent=tour.title;$('desc').textContent=tour.intro||'';$('empty').hidden=scenes.length>0;if(!scenes.length){$('loader').style.display='none';return}const floors=[...new Set(scenes.map(x=>x.floor_label||'Nivel 1'))];activeFloor=floors[0];$('floors').innerHTML=floors.map((f,i)=>'<button class="floor '+(!i?'active':'')+'" data-floor="'+esc(f)+'">'+esc(f)+'</button>').join('');$('floors').querySelectorAll('button').forEach(b=>b.onclick=()=>{activeFloor=b.dataset.floor;document.querySelectorAll('.floor').forEach(x=>x.classList.toggle('active',x===b));if(current&&!scenes.some(s=>s.id===current.id&&s.floor_label===activeFloor))openScene(scenes.find(s=>s.floor_label===activeFloor));renderSide()});openScene(scenes[0]);$('loader').style.display='none'}
function renderSide(){const plan=plans.find(p=>p.floor_label===activeFloor);$('plan').replaceChildren();if(plan){const img=document.createElement('img');img.src=plan.image_url;img.alt=plan.title;$('plan').append(img);scenes.filter(s=>s.plan_id===plan.id&&s.plan_x!==null&&s.plan_y!==null).forEach((s,i)=>{const b=document.createElement('button');b.className='marker '+(current?.id===s.id?'active':'');b.style.left=s.plan_x+'%';b.style.top=s.plan_y+'%';b.textContent=String(i+1);b.title=s.title;b.onclick=()=>openScene(s);$('plan').append(b)})}else $('plan').innerHTML='<p class="muted" style="padding:14px">No se ha asociado un plano a este nivel.</p>';
const items=scenes.filter(s=>(s.floor_label||'Nivel 1')===activeFloor);$('scenes').innerHTML=items.map(s=>'<div class="scene '+(current?.id===s.id?'active':'')+'" data-id="'+s.id+'"><img src="'+esc(s.panorama_url)+'" alt=""><div><strong>'+esc(s.title)+'</strong><small>'+esc(s.description||'Explorar ambiente')+'</small></div></div>').join('');$('scenes').querySelectorAll('.scene').forEach(n=>n.onclick=()=>openScene(scenes.find(s=>s.id===n.dataset.id)));
const linked=(current?.connected_scene_ids||[]).map(id=>scenes.find(s=>s.id===id)).filter(Boolean);$('connections').innerHTML=linked.length?'<span class="muted" style="width:100%">Continuar hacia</span>'+linked.map(s=>'<button data-next="'+s.id+'">'+esc(s.title)+' ↗</button>').join(''):'';$('connections').querySelectorAll('[data-next]').forEach(b=>b.onclick=()=>openScene(scenes.find(s=>s.id===b.dataset.next)))}
function openScene(scene){if(!scene)return;current=scene;activeFloor=scene.floor_label||'Nivel 1';$('title').textContent=scene.title;$('desc').textContent=scene.description||scene.floor_label||'';if(viewer){viewer.destroy();viewer=null}viewer=pannellum.viewer('viewer',{type:'equirectangular',panorama:scene.panorama_url,autoLoad:true,showControls:true,compass:false,mouseZoom:true,draggable:true,keyboardZoom:true,yaw:Number(scene.initial_yaw||0),pitch:Number(scene.initial_pitch||0),hfov:100});viewer.on('load',()=>$('loader').style.display='none');document.querySelectorAll('.floor').forEach(b=>b.classList.toggle('active',b.dataset.floor===activeFloor));renderSide()}
$('fullscreen').onclick=()=>{const e=$('viewer');if(e.requestFullscreen)e.requestFullscreen();else if(e.webkitRequestFullscreen)e.webkitRequestFullscreen()};$('reset').onclick=()=>{if(viewer){viewer.setYaw(0);viewer.setPitch(0);viewer.setHfov(100)}};$('auto').onclick=()=>{auto=!auto;$('auto').textContent=auto?'Ⅱ Pausar giro':'▶ Giro automático';if(viewer){if(auto)viewer.startAutoRotate(-2);else viewer.stopAutoRotate()}};boot().catch(e=>{$('loader').textContent=e.message||'No se pudo cargar el recorrido'});
</script></body></html>