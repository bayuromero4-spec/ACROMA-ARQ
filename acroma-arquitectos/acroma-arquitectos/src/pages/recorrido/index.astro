---
import { SUPABASE_URL, SUPABASE_KEY, hasSupabase } from '../../lib/supabase';
---
<!doctype html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101c32"/><title>Recorrido 360° · ACROMA</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0b1423;color:#fff;font-family:Inter,system-ui,sans-serif}
.top{height:58px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#101c32;border-bottom:1px solid #ffffff20}.brand{font-size:12px;letter-spacing:.18em}.brand b{color:#d4b36b}.top a{color:#fff;text-decoration:none;font-size:13px}
.layout{position:relative;height:calc(100dvh - 58px);width:100%;overflow:hidden}.main{position:absolute;inset:0;min-width:0;background:#080f1b}.viewer{position:absolute;inset:0}.overlay{position:absolute;z-index:5;left:24px;top:20px;max-width:min(620px,70vw);pointer-events:none;text-shadow:0 2px 12px #000}.eyebrow{font-size:10px;letter-spacing:.2em;color:#e2c17c}.overlay h1{font-size:clamp(22px,3vw,34px);margin:8px 0}.overlay p{color:#e0e4ea;margin:0;font-size:13px}
.controls{position:absolute;z-index:6;bottom:20px;left:50%;transform:translateX(-50%);display:flex;gap:8px;flex-wrap:wrap;justify-content:center;width:max-content;max-width:95%}.controls button,.floor{border:1px solid #ffffff30;background:#101c32e8;color:#fff;border-radius:999px;padding:10px 14px;cursor:pointer;backdrop-filter:blur(12px)}
.side{position:absolute;z-index:20;inset:0 auto 0 0;width:390px;max-width:92vw;background:#fbfaf7;color:#1c2635;box-shadow:10px 0 40px #0005;display:flex;flex-direction:column;transform:translateX(0);transition:transform .28s ease}.side.closed{transform:translateX(-105%)}.side-head{display:flex;align-items:center;gap:12px;padding:16px 18px;min-height:82px;border-bottom:1px solid #e8e9ec;background:#fffdfa}.side-mark{width:42px;height:42px;border-radius:10px;background:#101c32;color:#d4b36b;display:grid;place-items:center;font-weight:900;font-size:17px}.side-project{min-width:0;flex:1}.side-project strong{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.side-project small{display:block;color:#8993a2;font-size:12px;margin-top:3px}.close-panel{width:42px;height:42px;border:1px solid #dce0e6;background:#fff;border-radius:13px;color:#253044;font-size:25px;cursor:pointer}.side-scroll{overflow:auto;overscroll-behavior:contain;padding:14px 18px 18px;flex:1}.side-scroll h2{font-size:16px;margin:4px 0 6px}.muted{font-size:12px;color:#8d97a6;line-height:1.5}.section-label{font-size:11px;letter-spacing:.16em;font-weight:800;color:#9aa4b2;margin:18px 0 8px}.floor-list,.scene-list{display:grid;gap:5px}.floor-row,.scene{display:flex;align-items:center;gap:11px;width:100%;padding:8px;border:1px solid transparent;border-radius:13px;background:transparent;text-align:left;color:#1c2635;cursor:pointer}.floor-row.active,.scene.active{background:#f5eee4;border-color:#f1dfc8}.floor-row img,.scene img{width:76px;height:58px;flex:none;object-fit:cover;border-radius:10px;background:#e9edf1}.floor-row strong,.scene strong{display:block;font-size:14px;font-weight:750;line-height:1.25}.floor-row small,.scene small{display:block;color:#929baa;font-size:12px;margin-top:3px}.row-dot{width:8px;height:8px;border-radius:50%;background:#c9a55e;margin-left:auto;flex:none}.plan{position:relative;background:#f3f5f8;border-radius:12px;overflow:hidden;margin:10px 0}.plan img{display:block;width:100%;max-height:240px;object-fit:contain}.marker{position:absolute;transform:translate(-50%,-50%);width:27px;height:27px;border:2px solid #fff;border-radius:50%;background:#c6a35b;color:#142238;font-weight:800;font-size:11px;cursor:pointer;box-shadow:0 2px 10px #0005}.marker.active{background:#172944;color:white;outline:2px solid #c6a35b}.connections{display:flex;flex-wrap:wrap;gap:6px;margin:14px 0}.connections button{background:#f4f0e8;border:1px solid #e6d8bd;color:#66502b;border-radius:30px;padding:7px 10px;font-size:11px;cursor:pointer}.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:12px 0}.gallery img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:9px;cursor:zoom-in;border:1px solid #e2e5e9}.gallery-view{position:fixed;inset:0;z-index:40;background:#050a12ef;display:none;place-items:center;padding:20px}.gallery-view.open{display:grid}.gallery-view img{max-width:95vw;max-height:90vh;object-fit:contain}.gallery-view button{position:absolute;right:20px;top:20px;background:#ffffff20;color:white;border:1px solid #ffffff55;border-radius:50%;width:42px;height:42px;font-size:24px}.side-footer{padding:12px 14px max(14px,env(safe-area-inset-bottom));background:#fffdfa;border-top:1px solid #eceef1;display:grid;grid-template-columns:1fr 1fr;gap:8px}.foot-btn{min-height:48px;padding:10px 12px;border-radius:15px;border:1px solid #dfe3e8;background:#fff;color:#263143;font-size:13px;font-weight:750;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer}.foot-btn.primary{grid-column:1/-1;background:#c6a35b;border-color:#c6a35b;color:#142238}.foot-btn.wide{grid-column:1/-1}.progress-wrap{grid-column:1/-1;display:flex;align-items:center;justify-content:space-between;font-size:11px;color:#8b95a3}.progress-track{height:5px;border-radius:9px;background:#e9edf1;overflow:hidden;margin-top:5px}.progress-fill{height:100%;width:0;background:#c6a35b;transition:width .2s}.menu-toggle{position:absolute;z-index:12;top:16px;left:16px;width:46px;height:46px;border-radius:14px;border:1px solid #ffffff55;background:#101c32d9;color:#fff;font-size:23px;cursor:pointer;backdrop-filter:blur(10px);display:none}.scrim{position:absolute;z-index:18;inset:0;background:#050a1280;opacity:0;pointer-events:none;transition:opacity .28s}.scrim.open{opacity:1;pointer-events:auto}.empty{padding:28px;text-align:center;color:#8b95a3}.loader{position:absolute;inset:0;display:grid;place-items:center;background:#0b1423;z-index:10;color:#d6bd87}
@media(max-width:760px){.top{display:none}.layout{height:100dvh}.side{width:min(88vw,430px);max-width:88vw}.side-head{min-height:84px;padding:14px 13px}.side-scroll{padding:12px 13px 18px}.main{height:100dvh}.overlay{left:68px;top:18px;max-width:calc(100vw - 90px)}.overlay .eyebrow{font-size:9px}.overlay h1{font-size:19px;margin:5px 0}.overlay p{font-size:11px}.controls{bottom:16px;left:auto;right:14px;transform:none;justify-content:flex-end;width:auto}.controls button{font-size:11px;padding:9px 11px}.controls #auto{display:none}.menu-toggle{display:block}.scrim{display:block}.floor-row img,.scene img{width:76px;height:58px}.side-footer{gap:7px;padding:10px 11px max(12px,env(safe-area-inset-bottom))}.foot-btn{min-height:46px;font-size:12px}.foot-btn.primary{min-height:50px}.gallery-view{padding:12px}}
@media(min-width:761px){.side{inset:0 0 0 auto;width:380px;max-width:42vw;border-left:1px solid #ffffff22}.side.closed{transform:translateX(105%)}.menu-toggle{display:block;top:18px;left:auto;right:400px}.scrim{display:none}.side-footer{padding-bottom:16px}}
</style></head>
<body data-url={hasSupabase ? SUPABASE_URL : ''} data-key={hasSupabase ? SUPABASE_KEY : ''}><header class="top"><div class="brand">ACROMA <b>360 EXPERIENCE</b></div><a href="/proyectos">Ver proyectos ↗</a></header>
<div class="layout"><main class="main"><div id="viewer" class="viewer"></div><button id="menu-toggle" class="menu-toggle" aria-label="Abrir listado de escenas">☰</button><div id="scrim" class="scrim"></div><div class="overlay"><div class="eyebrow">RECORRIDO ARQUITECTÓNICO · 360°</div><h1 id="title">Preparando experiencia…</h1><p id="desc"></p></div><div class="controls"><button id="auto">▶ Giro automático</button><button id="fullscreen">⛶ Pantalla completa</button><button id="reset">◎ Restablecer vista</button></div><div id="loader" class="loader">Cargando recorrido…</div></main>
<aside id="side" class="side"><div class="side-head"><div class="side-mark">A</div><div class="side-project"><strong id="panel-title">ACROMA 360 Experience</strong><small id="panel-subtitle">RECORRIDO ARQUITECTÓNICO</small></div><button id="close-panel" class="close-panel" aria-label="Cerrar listado">×</button></div><div class="side-scroll"><p class="muted">Explora las plantas y selecciona cualquier ambiente para abrir su vista inmersiva.</p><div class="section-label">PLANTAS Y NIVELES</div><div id="floors" class="floor-list"></div><div id="plan" class="plan"></div><div class="section-label">ESCENAS Y AMBIENTES</div><div id="scenes" class="scene-list"></div><div id="connections" class="connections"></div><h2 id="gallery-title" hidden>Vistas y renders del ambiente</h2><div id="gallery" class="gallery"></div><div id="empty" class="empty" hidden>Este recorrido todavía no tiene ambientes publicados.</div></div><div class="side-footer"><div class="progress-wrap"><span>Progreso del recorrido</span><strong id="progress-label">0%</strong></div><div class="progress-wrap"><div class="progress-track" style="width:100%"><div id="progress-fill" class="progress-fill"></div></div></div><button id="share" class="foot-btn">▧ Compartir</button><button id="fullscreen-panel" class="foot-btn">⛶ Pantalla completa</button><a class="foot-btn primary wide" href="/contacto">✉ Contactar a ACROMA</a></div></aside></div><div id="gallery-view" class="gallery-view"><button id="gallery-close" aria-label="Cerrar">×</button><img id="gallery-large" alt="Vista ampliada"></div>
<script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script><script>
import { createClient } from '@supabase/supabase-js';
const sb=createClient(document.body.dataset.url||'',document.body.dataset.key||''),slug=new URLSearchParams(location.search).get('tour');let scenes=[],plans=[],viewer=null,current=null,auto=false,activeFloor=null,visited=new Set();
const $=id=>document.getElementById(id),esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function boot(){if(!slug)throw Error('Enlace de recorrido incompleto.');const preview=new URLSearchParams(location.search).get('preview')==='1';if(preview){const {data:{session}}=await sb.auth.getSession();if(!session)throw Error('La vista previa requiere iniciar sesión en ACROMA Business Hub en este mismo navegador.')}let query=sb.from('hub_project_tours').select('id,title,intro,status').eq('slug',slug);if(!preview)query=query.eq('status','published');const {data:tour,error}=await query.maybeSingle();if(error||!tour)throw Error('Este recorrido no está disponible.');if(preview){$('desc').textContent='VISTA PREVIA PRIVADA · '+(tour.intro||'Solo visible para el equipo ACROMA');}const [s,p]=await Promise.all([sb.from('hub_project_tour_scenes').select('*').eq('tour_id',tour.id).order('sort_order'),sb.from('hub_project_tour_plans').select('*').eq('tour_id',tour.id).order('sort_order')]);if(s.error)throw s.error;if(p.error)throw p.error;scenes=s.data||[];plans=p.data||[];$('title').textContent=tour.title;$('panel-title').textContent=tour.title;$('panel-subtitle').textContent=preview?'VISTA PREVIA PRIVADA':'EXPERIENCIA 360° · ACROMA';$('desc').textContent=tour.intro||'';$('empty').hidden=scenes.length>0;if(!scenes.length){$('loader').style.display='none';return}const floors=[...new Set([...plans.map(x=>x.floor_label),...scenes.map(x=>x.floor_label||'Nivel 1')].filter(Boolean))];activeFloor=floors[0]||'Nivel 1';renderSide();openScene(scenes[0]);$('loader').style.display='none'}
function renderSide(){const plan=plans.find(p=>p.floor_label===activeFloor);$('floors').innerHTML=plans.map(p=>'<button class="floor-row '+(p.floor_label===activeFloor?'active':'')+'" data-floor="'+esc(p.floor_label)+'"><img src="'+esc(p.image_url)+'" alt=""><span><strong>'+esc(p.title||p.floor_label)+'</strong><small>Plano del nivel</small></span>'+(p.floor_label===activeFloor?'<i class="row-dot"></i>':'')+'</button>').join('');$('floors').querySelectorAll('[data-floor]').forEach(b=>b.onclick=()=>{activeFloor=b.dataset.floor;const first=scenes.find(x=>(x.floor_label||'Nivel 1')===activeFloor);if(first)openScene(first);else renderSide()});$('plan').replaceChildren();if(plan){const img=document.createElement('img');img.src=plan.image_url;img.alt=plan.title;$('plan').append(img);scenes.filter(s=>s.plan_id===plan.id&&s.plan_x!==null&&s.plan_y!==null).forEach((s,i)=>{const b=document.createElement('button');b.className='marker '+(current?.id===s.id?'active':'');b.style.left=s.plan_x+'%';b.style.top=s.plan_y+'%';b.textContent=String(i+1);b.title=s.title;b.onclick=()=>openScene(s);$('plan').append(b)})}else $('plan').innerHTML='<p class="muted" style="padding:14px">No se ha asociado un plano a este nivel.</p>';
const items=scenes.filter(s=>(s.floor_label||'Nivel 1')===activeFloor);$('scenes').innerHTML=items.map((s,i)=>'<button class="scene '+(current?.id===s.id?'active':'')+'" data-id="'+s.id+'"><img src="'+esc(s.panorama_url)+'" alt=""><span><strong>'+esc(s.title)+'</strong><small>Vista de 360 grados</small></span>'+(current?.id===s.id?'<i class="row-dot"></i>':'')+'</button>').join('');$('scenes').querySelectorAll('.scene').forEach(n=>n.onclick=()=>openScene(scenes.find(s=>s.id===n.dataset.id)));
const gallery=current?.gallery_urls||[];$('gallery-title').hidden=!gallery.length;$('gallery').innerHTML=gallery.map((url,i)=>'<img src="'+esc(url)+'" alt="Vista '+(i+1)+' de '+esc(current.title)+'" loading="lazy" data-gallery="'+i+'">').join('');$('gallery').querySelectorAll('[data-gallery]').forEach(img=>img.onclick=()=>{const url=gallery[Number(img.dataset.gallery)];$('gallery-large').src=url;$('gallery-view').classList.add('open')});const linked=(current?.connected_scene_ids||[]).map(id=>scenes.find(s=>s.id===id)).filter(Boolean);$('connections').innerHTML=linked.length?'<span class="muted" style="width:100%">Continuar hacia</span>'+linked.map(s=>'<button data-next="'+s.id+'">'+esc(s.title)+' ↗</button>').join(''):'';$('connections').querySelectorAll('[data-next]').forEach(b=>b.onclick=()=>openScene(scenes.find(s=>s.id===b.dataset.next)))}
function updateProgress(){const value=scenes.length?Math.round(visited.size/scenes.length*100):0;$('progress-label').textContent=value+'%';$('progress-fill').style.width=value+'%'}function openScene(scene){if(!scene)return;current=scene;visited.add(scene.id);updateProgress();activeFloor=scene.floor_label||'Nivel 1';$('title').textContent=scene.title;$('desc').textContent=scene.description||scene.floor_label||'';if(viewer){viewer.destroy();viewer=null}viewer=pannellum.viewer('viewer',{type:'equirectangular',panorama:scene.panorama_url,autoLoad:true,showControls:true,compass:false,mouseZoom:true,draggable:true,keyboardZoom:true,yaw:Number(scene.initial_yaw||0),pitch:Number(scene.initial_pitch||0),hfov:100});viewer.on('load',()=>$('loader').style.display='none');document.querySelectorAll('.floor').forEach(b=>b.classList.toggle('active',b.dataset.floor===activeFloor));renderSide()}
const side=$('side'),scrim=$('scrim');function setPanel(open){side.classList.toggle('closed',!open);scrim.classList.toggle('open',open)}$('menu-toggle').onclick=()=>setPanel(side.classList.contains('closed'));$('close-panel').onclick=()=>setPanel(false);scrim.onclick=()=>setPanel(false);$('share').onclick=async()=>{const url=location.href;try{if(navigator.share)await navigator.share({title:$('panel-title').textContent,text:'Explora el recorrido 360° de ACROMA',url});else{await navigator.clipboard.writeText(url);$('share').textContent='✓ Enlace copiado';setTimeout(()=>$('share').textContent='▧ Compartir',1800)}}catch(e){if(e.name!=='AbortError')alert('No se pudo compartir el enlace.')}};$('fullscreen-panel').onclick=()=>{const e=$('viewer');if(e.requestFullscreen)e.requestFullscreen();else if(e.webkitRequestFullscreen)e.webkitRequestFullscreen()};if(matchMedia('(max-width:760px)').matches)setPanel(true);$('gallery-close').onclick=()=>$('gallery-view').classList.remove('open');$('gallery-view').onclick=e=>{if(e.target===$('gallery-view'))$('gallery-view').classList.remove('open')};$('fullscreen').onclick=()=>{const e=$('viewer');if(e.requestFullscreen)e.requestFullscreen();else if(e.webkitRequestFullscreen)e.webkitRequestFullscreen()};$('reset').onclick=()=>{if(viewer){viewer.setYaw(0);viewer.setPitch(0);viewer.setHfov(100)}};$('auto').onclick=()=>{auto=!auto;$('auto').textContent=auto?'Ⅱ Pausar giro':'▶ Giro automático';if(viewer){if(auto)viewer.startAutoRotate(-2);else viewer.stopAutoRotate()}};boot().catch(e=>{$('loader').textContent=e.message||'No se pudo cargar el recorrido'});
</script></body></html>