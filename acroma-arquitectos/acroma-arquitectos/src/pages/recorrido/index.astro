---
import { SUPABASE_URL, SUPABASE_KEY, hasSupabase } from '../../lib/supabase';
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#101c32"/><title>Recorrido 360° · ACROMA</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.css"/>
<style>*{box-sizing:border-box}body{margin:0;background:#0b1423;color:#fff;font-family:Inter,system-ui,sans-serif}.top{height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#101c32;border-bottom:1px solid #ffffff20}.brand{font-size:12px;letter-spacing:.18em}.brand b{color:#d4b36b}.top a{color:#fff;text-decoration:none;font-size:13px}.layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;height:calc(100dvh - 68px)}.main{position:relative;min-width:0}.viewer{position:absolute;inset:0}.overlay{position:absolute;z-index:5;left:24px;top:22px;pointer-events:none}.eyebrow{font-size:10px;letter-spacing:.2em;color:#d8bb7c}.overlay h1{font-size:clamp(22px,3vw,34px);margin:8px 0}.overlay p{color:#d0d6df;margin:0;font-size:13px}.controls{position:absolute;z-index:6;bottom:22px;left:50%;transform:translateX(-50%);display:flex;gap:8px;flex-wrap:wrap;justify-content:center;width:max-content;max-width:95%}.controls button,.floor{border:1px solid #ffffff30;background:#101c32e8;color:#fff;border-radius:999px;padding:10px 15px;cursor:pointer;backdrop-filter:blur(12px)}.side{background:#111f34;border-left:1px solid #ffffff18;padding:22px;overflow:auto}.side h2{font-size:17px;margin:0 0 6px}.muted{font-size:12px;color:#9ba9bb}.floor{margin:16px 5px 8px 0}.floor.active{background:#c7a45f;color:#142238;border-color:#c7a45f}.scene{display:flex;gap:11px;padding:10px;border-radius:12px;cursor:pointer;border:1px solid transparent;margin:5px 0}.scene.active{background:#ffffff12;border-color:#c7a45f80}.scene img{width:82px;height:62px;object-fit:cover;border-radius:8px}.scene strong{font-size:13px;display:block;margin:4px 0}.scene small{color:#9ba9bb}.empty{padding:30px;text-align:center;color:#c4ccd6}.loader{position:absolute;inset:0;display:grid;place-items:center;background:#0b1423;z-index:10;color:#d6bd87}@media(max-width:760px){.layout{display:flex;flex-direction:column;height:calc(100dvh - 60px)}.top{height:60px;padding:0 16px}.main{height:58dvh;min-height:360px;flex:none}.side{flex:1;border-left:0;border-top:1px solid #ffffff18;padding:16px}.overlay{left:16px;top:14px}.overlay p{max-width:75vw}.controls{bottom:12px}.scene img{width:70px;height:54px}}</style></head>
<body data-url={hasSupabase ? SUPABASE_URL : ''} data-key={hasSupabase ? SUPABASE_KEY : ''}><header class="top"><div class="brand">ACROMA <b>360 EXPERIENCE</b></div><a href="/proyectos">Ver proyectos ↗</a></header><div id="app" class="layout"><div class="main"><div id="viewer" class="viewer"></div><div class="overlay"><div class="eyebrow">RECORRIDO ARQUITECTÓNICO</div><h1 id="title">Preparando experiencia…</h1><p id="desc"></p></div><div class="controls"><button id="auto">▶ Recorrido automático</button><button id="fullscreen">⛶ Pantalla completa</button><button id="reset">◎ Restablecer vista</button></div><div id="loader" class="loader">Cargando recorrido…</div></div><aside class="side"><h2>Explora los ambientes</h2><p class="muted">Selecciona un espacio para desplazarte por el proyecto.</p><div id="floors"></div><div id="scenes"></div><div id="empty" class="empty" hidden>Este recorrido aún no tiene ambientes publicados.</div></aside></div>
<script src="https://cdn.jsdelivr.net/npm/pannellum@2.5.6/build/pannellum.js"></script><script>
import { createClient } from '@supabase/supabase-js';
const sb=createClient(document.body.dataset.url||'',document.body.dataset.key||'');const slug=new URLSearchParams(location.search).get('tour');let scenes=[],viewer=null,current=null,auto=false;
const $=id=>document.getElementById(id);const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function boot(){if(!slug)throw new Error('Enlace de recorrido incompleto.');const {data:tour,error}=await sb.from('hub_project_tours').select('id,title,intro,status').eq('slug',slug).eq('status','published').maybeSingle();if(error||!tour)throw new Error('Este recorrido no está disponible.');const {data,error:sceneError}=await sb.from('hub_project_tour_scenes').select('*').eq('tour_id',tour.id).order('sort_order');if(sceneError)throw sceneError;scenes=data||[];$('title').textContent=tour.title;$('desc').textContent=tour.intro||'';$('empty').hidden=scenes.length>0;if(!scenes.length)return;renderFloors();openScene(scenes[0]);$('loader').style.display='none';}
function renderFloors(){const floors=[...new Set(scenes.map(s=>s.floor_label||'Nivel 1'))];$('floors').innerHTML=floors.map((f,i)=>'<button class="floor '+(!i?'active':'')+'" data-floor="'+esc(f)+'">'+esc(f)+'</button>').join('');$('floors').querySelectorAll('button').forEach(b=>b.onclick=()=>{document.querySelectorAll('.floor').forEach(x=>x.classList.toggle('active',x===b));renderScenes(b.dataset.floor)});renderScenes(floors[0]);}
function renderScenes(floor){const items=scenes.filter(s=>(s.floor_label||'Nivel 1')===floor);$('scenes').innerHTML=items.map(s=>'<div class="scene '+(current?.id===s.id?'active':'')+'" data-id="'+s.id+'"><img src="'+esc(s.panorama_url)+'" alt=""><div><strong>'+esc(s.title)+'</strong><small>'+esc(s.description||'Explorar ambiente')+'</small></div></div>').join('');$('scenes').querySelectorAll('.scene').forEach(n=>n.onclick=()=>openScene(scenes.find(s=>s.id===n.dataset.id)));}
function openScene(scene){if(!scene)return;current=scene;$('title').textContent=scene.title;$('desc').textContent=scene.description||scene.floor_label||'';if(viewer){viewer.destroy();viewer=null;}viewer=pannellum.viewer('viewer',{type:'equirectangular',panorama:scene.panorama_url,autoLoad:true,showControls:true,compass:false,mouseZoom:true,draggable:true,keyboardZoom:true,yaw:Number(scene.initial_yaw||0),pitch:Number(scene.initial_pitch||0),hfov:100});viewer.on('load',()=>{$('loader').style.display='none'});renderScenes(scene.floor_label||'Nivel 1');}
$('fullscreen').onclick=()=>{const e=$('viewer');if(e.requestFullscreen)e.requestFullscreen();else if(e.webkitRequestFullscreen)e.webkitRequestFullscreen()};$('reset').onclick=()=>viewer?.setHfov(100);$('auto').onclick=()=>{auto=!auto;$('auto').textContent=auto?'Ⅱ Pausar recorrido':'▶ Recorrido automático';if(viewer){if(auto)viewer.startAutoRotate(-2);else viewer.stopAutoRotate()}};boot().catch(e=>{$('loader').textContent=e.message||'No se pudo cargar el recorrido';});
</script></body></html>