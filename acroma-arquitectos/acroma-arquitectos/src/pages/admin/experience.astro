---
import { SUPABASE_URL, SUPABASE_KEY, hasSupabase } from '../../lib/supabase';
---
<!doctype html>
<html lang="es">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#101c32"/><title>ACROMA 360 Experience · Editor</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#17243a;background:#f3f5f8;font-synthesis:none}*{box-sizing:border-box}body{margin:0}.top{height:66px;background:#101c32;color:white;padding:0 clamp(16px,4vw,54px);display:flex;align-items:center;justify-content:space-between}.brand{font-size:12px;letter-spacing:.17em}.brand b{color:#d4b36b}.top a{color:white;text-decoration:none;font-size:13px}.wrap{max-width:1240px;margin:34px auto;padding:0 20px}.hero{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#9a7a3e;font-weight:750}.hero h1{font-size:clamp(30px,4vw,44px);margin:8px 0}.muted{color:#748196;line-height:1.55}.badge{background:#f5eddc;color:#82652e;border-radius:30px;padding:9px 14px;font-size:12px}.layout{display:grid;grid-template-columns:260px minmax(0,1fr);gap:20px;align-items:start}.steps,.panel{background:white;border:1px solid #e4e8ef;border-radius:20px;box-shadow:0 12px 35px #1a2b4308}.steps{padding:14px;position:sticky;top:16px}.step{display:flex;gap:12px;padding:14px 10px;border-radius:12px;cursor:pointer;color:#758196;font-size:14px}.step.active{background:#f2f4f8;color:#15243c;font-weight:700}.num{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#edf0f4;font-size:12px}.step.active .num{background:#c9a75f;color:#14223a}.panel{padding:clamp(18px,3vw,30px);min-width:0}.panel h2{font-size:22px;margin:0 0 6px}.panel-head{margin-bottom:22px}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field{display:grid;gap:7px;margin:10px 0}.field.full{grid-column:1/-1}label{font-size:11px;font-weight:750;letter-spacing:.08em;color:#69768a}input,select,textarea{width:100%;border:1px solid #dce2eb;border-radius:10px;padding:12px 13px;font:inherit;color:#18243a;background:#fff;min-height:44px}textarea{min-height:90px;resize:vertical}.btn{border:0;border-radius:10px;padding:12px 16px;background:#152640;color:#fff;font-weight:650;cursor:pointer}.btn.gold{background:#c6a45e;color:#14223a}.btn.light{background:#eef1f5;color:#26364e}.btn.danger{background:#f8eaea;color:#a33b3b}.btn:disabled{opacity:.5;cursor:wait}.actions{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin-top:18px}.notice{padding:14px 16px;border-radius:12px;background:#f3f6fa;color:#596a80;font-size:13px;line-height:1.6;margin:14px 0}.divider{height:1px;background:#e8ecf1;margin:24px 0}.plan-card,.scene-card{border:1px solid #e5e9ef;border-radius:14px;padding:12px;margin:10px 0;display:grid;gap:12px;align-items:center}.plan-card{grid-template-columns:120px minmax(0,1fr) auto}.plan-card img{width:120px;height:78px;object-fit:contain;background:#f3f5f8;border-radius:8px}.scene-card{grid-template-columns:90px minmax(0,1fr) auto}.scene-card img{width:90px;height:66px;object-fit:cover;border-radius:8px}.small{font-size:12px;color:#8290a2}.map-editor{position:relative;border:1px dashed #cbd3df;border-radius:14px;overflow:hidden;background:#f4f6f9;min-height:170px;cursor:crosshair}.map-editor img{display:block;width:100%;max-height:440px;object-fit:contain;pointer-events:none}.pin{position:absolute;width:25px;height:25px;border:2px solid white;background:#c49d4e;color:#12213a;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:800;transform:translate(-50%,-50%);box-shadow:0 2px 10px #0004;pointer-events:none}.empty{padding:25px;text-align:center;border:1px dashed #d7dee8;border-radius:14px;color:#8995a6;font-size:13px}.hidden{display:none!important}.status{font-size:12px;border-radius:30px;padding:7px 11px;background:#f5eddc;color:#80652e}.status.live{background:#e5f4ec;color:#26744c}
@media(max-width:760px){.wrap{margin:22px auto}.layout{grid-template-columns:1fr}.steps{position:static;display:grid;grid-template-columns:repeat(3,1fr);gap:4px;padding:7px}.step{display:grid;justify-items:center;text-align:center;gap:5px;padding:9px 4px;font-size:10px}.grid{grid-template-columns:1fr}.field.full{grid-column:auto}.plan-card{grid-template-columns:82px 1fr}.plan-card img{width:82px;height:65px}.plan-card .actions{grid-column:1/-1;margin:0}.scene-card{grid-template-columns:70px 1fr}.scene-card img{width:70px;height:60px}.scene-card .actions{grid-column:1/-1;margin:0}.hero{align-items:start;flex-direction:column}}
</style></head>
<body data-url={hasSupabase ? SUPABASE_URL : ''} data-key={hasSupabase ? SUPABASE_KEY : ''}>
<header class="top"><div class="brand">ACROMA <b>360 EXPERIENCE</b></div><a href="/admin/hub">← Business Hub</a></header>
<main class="wrap">
 <div class="hero"><div><p class="eyebrow">ESTUDIO · EXPERIENCIAS INMERSIVAS</p><h1>Editor de recorridos 360°</h1><p class="muted">Construye una experiencia conectando plantas, ambientes y vistas panorámicas.</p></div><span id="connection" class="badge">Conectando…</span></div>
 <div class="layout"><nav class="steps" aria-label="Etapas del editor"><div class="step active" data-step="0"><span class="num">01</span><span>Proyecto</span></div><div class="step" data-step="1"><span class="num">02</span><span>Planos</span></div><div class="step" data-step="2"><span class="num">03</span><span>Ambientes</span></div></nav>
 <section class="panel" id="app">Cargando editor…</section></div>
</main>
<script>
import { createClient } from '@supabase/supabase-js';
const app=document.getElementById('app'), connection=document.getElementById('connection');
const sb=createClient(document.body.dataset.url||'',document.body.dataset.key||'');
const requested=new URLSearchParams(location.search).get('project');
let projects=[],tour=null,plans=[],scenes=[],step=0,selectedPlan=null,placement={x:null,y:null};
const $=(tag,cls='',txt='')=>{const n=document.createElement(tag);if(cls)n.className=cls;if(txt)n.textContent=txt;return n};
const button=(txt,fn,cls='btn')=>{const b=$('button',cls,txt);b.type='button';b.onclick=fn;return b};
const field=(label,name,type='text',value='')=>{const w=$('div','field'),l=$('label','',label),i=$(type==='textarea'?'textarea':'input');if(type!=='textarea')i.type=type;i.name=name;i.value=value||'';w.append(l,i);return w};
const notice=t=>$('div','notice',t);
function nav(){document.querySelectorAll('.step').forEach(n=>{n.classList.toggle('active',Number(n.dataset.step)===step);n.onclick=()=>{if(!tour&&Number(n.dataset.step)>0)return;step=Number(n.dataset.step);render()}})}
async function start(){
 if(!document.body.dataset.url||!document.body.dataset.key){app.textContent='Faltan las variables públicas de Supabase.';return}
 const {data:{session}}=await sb.auth.getSession();
 if(!session){app.replaceChildren($('h2','','Inicia sesión en ACROMA'));const form=$('form','grid'),em=field('CORREO','email','email'),pw=field('CONTRASEÑA','password','password'),submit=button('Ingresar',()=>{} ,'btn gold');submit.type='submit';form.append(em,pw,submit);form.onsubmit=async e=>{e.preventDefault();const {error}=await sb.auth.signInWithPassword({email:em.querySelector('input').value,password:pw.querySelector('input').value});if(error)alert(error.message);else start()};app.append(form);return}
 const {data:permissions,error:permissionError}=await sb.rpc('get_my_permissions');const codes=(permissions||[]).map(p=>p.permission_code);
 if(permissionError||(!codes.includes('hub.dashboard')&&!codes.includes('dashboard.read'))){app.textContent='Tu usuario no tiene permisos para administrar recorridos 360°.';return}
 const {data,error}=await sb.from('hub_projects').select('id,title,project_code,location').order('created_at',{ascending:false});
 if(error){app.textContent='No se pudieron cargar los proyectos: '+error.message;return}projects=data||[];
 if(requested){const {data:found}=await sb.from('hub_project_tours').select('*').eq('project_id',requested).maybeSingle();tour=found}
 await reload();connection.textContent='Conectado';render();
}
async function reload(){if(!tour){plans=[];scenes=[];return}const [p,s]=await Promise.all([sb.from('hub_project_tour_plans').select('*').eq('tour_id',tour.id).order('sort_order'),sb.from('hub_project_tour_scenes').select('*').eq('tour_id',tour.id).order('sort_order')]);if(p.error)throw p.error;if(s.error)throw s.error;plans=p.data||[];scenes=s.data||[]}
function render(){nav();app.replaceChildren();if(step===0)projectStep();if(step===1)planStep();if(step===2)sceneStep()}
function head(kicker,title,desc){const w=$('div','panel-head');w.append($('p','eyebrow',kicker),$('h2','',title),$('p','muted',desc));return w}
function projectStep(){app.append(head('01 · CONFIGURACIÓN','Vincula tu proyecto','La experiencia 360° pertenece a un proyecto de ACROMA y se publica cuando esté lista.'));
 const form=$('div','grid');const project=$('div','field'),select=$('select');project.append($('label','','PROYECTO'));projects.forEach(p=>{const o=$('option','',p.title+' · '+(p.project_code||''));o.value=p.id;if((tour?.project_id||requested)===p.id)o.selected=true;select.append(o)});project.append(select);form.append(project,field('TÍTULO DE LA EXPERIENCIA','title','text',tour?.title||'Recorrido virtual'),field('ENLACE PERSONALIZADO (SLUG)','slug','text',tour?.slug||''),field('PRESENTACIÓN PARA EL CLIENTE','intro','textarea',tour?.intro||''));app.append(form,notice('Ejemplo: “Casa de Campo · Recorrido inmersivo”. Después podrás organizar planos por nivel y ubicar cada ambiente sobre su planta.'));
 const actions=$('div','actions');const status=$('span','status '+(tour?.status==='published'?'live':''),tour?.status==='published'?'Publicado':'Borrador');const save=button(tour?'Guardar proyecto':'Crear experiencia',async()=>{save.disabled=true;try{const title=form.querySelector('[name=title]').value.trim(),slug=form.querySelector('[name=slug]').value.trim().toLowerCase().replace(/[^a-z0-9-]/g,'-');if(!select.value||!title||!slug)throw Error('Completa proyecto, título y slug.');const payload={project_id:select.value,title,slug,intro:form.querySelector('[name=intro]').value,status:tour?.status||'draft',created_by:(await sb.auth.getUser()).data.user.id};const result=tour?await sb.from('hub_project_tours').update(payload).eq('id',tour.id).select().single():await sb.from('hub_project_tours').insert(payload).select().single();if(result.error)throw result.error;tour=result.data;history.replaceState({},'','?project='+select.value);step=1;await reload();render()}catch(e){alert(e.message||'No se pudo guardar')}finally{save.disabled=false}},'btn gold');actions.append(status,save);if(tour){actions.append(button(tour.status==='published'?'Retirar publicación':'Publicar experiencia',async()=>{const status=tour.status==='published'?'draft':'published';const {error}=await sb.from('hub_project_tours').update({status}).eq('id',tour.id);if(error)alert(error.message);else{tour.status=status;render()}},'btn'));}app.append(actions)}
function planStep(){app.append(head('02 · ORGANIZACIÓN ESPACIAL','Planos por nivel','Sube una imagen de cada planta. Después podrás colocar los puntos de vista de cada ambiente directamente sobre el plano.'));
 const form=$('form','grid'),title=field('NOMBRE DEL PLANO','plan_title','text','Planta arquitectónica'),floor=field('NIVEL / PISO','floor_label','text','Primer piso'),file=field('IMAGEN DEL PLANO (JPG / PNG / WEBP)','plan_file','file');file.querySelector('input').accept='image/jpeg,image/png,image/webp';form.append(title,floor,file);const add=button('Agregar plano',()=>{},'btn gold');add.type='submit';form.append(add);form.onsubmit=async e=>{e.preventDefault();add.disabled=true;try{const f=file.querySelector('input').files[0];if(!f||!['image/jpeg','image/png','image/webp'].includes(f.type))throw Error('Selecciona un plano en JPG, PNG o WEBP.');if(f.size>20*1024*1024)throw Error('El plano supera 20 MB.');const path=tour.id+'/'+crypto.randomUUID()+'.'+f.name.split('.').pop().toLowerCase();const up=await sb.storage.from('acroma-360-plans').upload(path,f,{contentType:f.type});if(up.error)throw up.error;const url=sb.storage.from('acroma-360-plans').getPublicUrl(path).data.publicUrl;const ins=await sb.from('hub_project_tour_plans').insert({tour_id:tour.id,title:title.querySelector('input').value.trim()||'Planta',floor_label:floor.querySelector('input').value.trim()||'Nivel 1',image_url:url,sort_order:plans.length});if(ins.error)throw ins.error;await reload();render()}catch(e){alert(e.message||'No se pudo agregar el plano')}finally{add.disabled=false}};app.append(form,notice('Formato recomendado: exporta cada planta desde AutoCAD, Revit o Archicad como PNG/JPG nítido, preferiblemente con fondo claro. El plano será interactivo, no solo una descarga.'));
 if(plans.length){const list=$('div');plans.forEach(p=>{const card=$('div','plan-card'),img=$('img');img.src=p.image_url;img.alt=p.title;const info=$('div');info.append($('strong','',p.title),$('div','small',p.floor_label),$('div','small',scenes.filter(s=>s.plan_id===p.id).length+' ambientes ubicados'));const actions=$('div','actions');actions.append(button('Usar para ubicar ambientes',()=>{selectedPlan=p.id;step=2;render()},'btn gold'),button('Eliminar',async()=>{if(!confirm('¿Eliminar plano? Los ambientes asociados quedarán sin plano.'))return;const {error}=await sb.from('hub_project_tour_plans').delete().eq('id',p.id);if(error)alert(error.message);else{await reload();render()}},'btn danger'));card.append(img,info,actions);list.append(card)});app.append($('div','divider'),list)}else app.append($('div','empty','','Aún no hay planos. Agrega la primera planta para empezar a ubicar ambientes.'));const footer=$('div','actions');footer.append(button('Continuar a ambientes →',()=>{step=2;render()},'btn gold'));app.append(footer)}
function sceneStep(){app.append(head('03 · RECORRIDO','Ambientes y conexiones','Cada ambiente tendrá una panorámica 360°, una ubicación en el plano y conexiones hacia otros espacios.'));
 const form=$('form','grid');const title=field('NOMBRE DEL AMBIENTE','scene_title','text','Sala principal'),floor=$('div','field'),floorSelect=$('select');floor.append($('label','','NIVEL / PLANTA'));plans.forEach(p=>{const o=$('option','',p.floor_label+' · '+p.title);o.value=p.id;if((selectedPlan||plans[0]?.id)===p.id)o.selected=true;floorSelect.append(o)});floor.append(floorSelect);const desc=field('DESCRIPCIÓN','description','text','Ambiente social principal'),file=field('PANORÁMICA 360°','panorama','file');file.querySelector('input').accept='image/jpeg,image/png,image/webp';const links=$('div','field full');links.append($('label','','CONECTAR CON OTROS AMBIENTES'));const checks=$('div','grid');scenes.forEach(s=>{const lab=$('label');lab.style.display='flex';lab.style.gap='8px';lab.style.alignItems='center';const cb=$('input');cb.type='checkbox';cb.value=s.id;lab.append(cb,document.createTextNode(s.title+' · '+s.floor_label));checks.append(lab)});links.append(checks);form.append(title,floor,desc,file,links);
 const mapWrap=$('div','field full');mapWrap.append($('label','','UBICACIÓN EN EL PLANO · TOCA EL PUNTO DONDE ESTÁ ESTE AMBIENTE'));const map=$('div','map-editor');const currentPlan=()=>plans.find(p=>p.id===floorSelect.value);function drawMap(){map.replaceChildren();const p=currentPlan();if(!p){map.append($('div','empty','','Primero agrega un plano en la etapa 02.'));return}const img=$('img');img.src=p.image_url;img.alt='Plano '+p.title;map.append(img);scenes.filter(s=>s.plan_id===p.id&&s.plan_x!==null&&s.plan_y!==null).forEach((s,i)=>{const pin=$('span','pin',String(i+1));pin.style.left=s.plan_x+'%';pin.style.top=s.plan_y+'%';map.append(pin)});if(placement.x!==null){const pin=$('span','pin','●');pin.style.left=placement.x+'%';pin.style.top=placement.y+'%';map.append(pin)}}floorSelect.onchange=()=>{selectedPlan=floorSelect.value;placement={x:null,y:null};drawMap()};map.onclick=e=>{const r=map.getBoundingClientRect();placement={x:Math.round((e.clientX-r.left)/r.width*1000)/10,y:Math.round((e.clientY-r.top)/r.height*1000)/10};drawMap()};mapWrap.append(map);form.append(mapWrap);drawMap();const submit=button('Guardar ambiente',()=>{},'btn gold');submit.type='submit';form.append(submit);form.onsubmit=async e=>{e.preventDefault();submit.disabled=true;try{const f=file.querySelector('input').files[0];if(!f||!['image/jpeg','image/png','image/webp'].includes(f.type))throw Error('Selecciona una panorámica 360° JPG, PNG o WEBP.');if(f.size>50*1024*1024)throw Error('La panorámica supera 50 MB.');if(!floorSelect.value)throw Error('Agrega primero un plano y selecciona el nivel.');if(placement.x===null)throw Error('Marca la ubicación del ambiente en el plano.');const path=tour.id+'/'+crypto.randomUUID()+'.'+f.name.split('.').pop().toLowerCase();const up=await sb.storage.from('acroma-360').upload(path,f,{contentType:f.type});if(up.error)throw up.error;const url=sb.storage.from('acroma-360').getPublicUrl(path).data.publicUrl;const connected=[...checks.querySelectorAll('input:checked')].map(c=>c.value);const ins=await sb.from('hub_project_tour_scenes').insert({tour_id:tour.id,title:title.querySelector('input').value.trim(),floor_label:currentPlan().floor_label,description:desc.querySelector('input').value,panorama_url:url,sort_order:scenes.length,plan_id:floorSelect.value,plan_x:placement.x,plan_y:placement.y,connected_scene_ids:connected});if(ins.error)throw ins.error;await reload();placement={x:null,y:null};render()}catch(e){alert(e.message||'No se pudo guardar el ambiente')}finally{submit.disabled=false}};app.append(form,notice('Recomendación: conecta ambientes siguiendo la circulación real del proyecto. Ejemplo: ingreso → sala → comedor → cocina; desde el pasillo conecta dormitorios y baños.'));
 if(scenes.length){app.append($('div','divider'),$('h2','','Ambientes creados'));scenes.forEach((s,i)=>{const card=$('div','scene-card'),img=$('img');img.src=s.panorama_url;const info=$('div');info.append($('strong','',String(i+1).padStart(2,'0')+' · '+s.title),$('div','small',s.floor_label+' · '+(plans.find(p=>p.id===s.plan_id)?.title||'Sin plano')), $('div','small', 'Conexiones: '+(s.connected_scene_ids||[]).length));card.append(img,info,button('Eliminar',async()=>{if(!confirm('¿Eliminar ambiente?'))return;const {error}=await sb.from('hub_project_tour_scenes').delete().eq('id',s.id);if(error)alert(error.message);else{await reload();render()}},'btn danger'));app.append(card)})}
 const actions=$('div','actions');actions.append(button('← Planos',()=>{step=1;render()},'btn light'));if(scenes.length)actions.append(button('Copiar enlace de vista previa',()=>navigator.clipboard.writeText(location.origin+'/recorrido/?tour='+tour.slug),'btn'));app.append(actions)}
start().catch(e=>{connection.textContent='Error';app.textContent=e.message||'No se pudo iniciar el editor'});
</script></body></html>