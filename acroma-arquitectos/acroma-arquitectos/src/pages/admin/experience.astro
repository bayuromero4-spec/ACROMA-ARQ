---
import { SUPABASE_URL, SUPABASE_KEY, hasSupabase } from '../../lib/supabase';
---
<!doctype html>
<html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#101c32"/><title>ACROMA 360 Experience · Administración</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#18243a;background:#f3f5f8}*{box-sizing:border-box}body{margin:0}.top{background:#101c32;color:#fff;padding:22px clamp(18px,4vw,56px);display:flex;justify-content:space-between;align-items:center}.brand{letter-spacing:.16em;font-size:12px}.brand b{color:#d4b36b}.wrap{max-width:1120px;margin:36px auto;padding:0 20px}.head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:24px}.head h1{font-size:clamp(26px,4vw,38px);margin:0 0 8px}.muted{color:#718096}.card{background:white;border:1px solid #e3e8ef;border-radius:18px;padding:24px;margin:18px 0;box-shadow:0 12px 34px #16243a0a}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field{display:grid;gap:7px;margin:12px 0}.field.full{grid-column:1/-1}label{font-size:12px;font-weight:700;letter-spacing:.06em;color:#536176}input,select,textarea{width:100%;border:1px solid #d8dee8;border-radius:10px;padding:12px 13px;font:inherit;background:#fff;color:#18243a}textarea{min-height:84px}.btn{border:0;border-radius:999px;padding:12px 18px;background:#142541;color:#fff;font-weight:650;cursor:pointer}.btn.gold{background:#c6a35b;color:#17243a}.btn.light{background:#edf1f6;color:#263650}.btn:disabled{opacity:.55;cursor:wait}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.scene{display:grid;grid-template-columns:100px 1fr auto;gap:14px;align-items:center;border:1px solid #e5e9ef;border-radius:14px;padding:12px;margin:10px 0}.scene img{width:100px;height:66px;object-fit:cover;border-radius:8px;background:#edf1f6}.status{font-size:12px;padding:7px 10px;border-radius:99px;background:#f7f0df;color:#806328}.status.live{background:#e6f4ed;color:#26744c}.notice{padding:13px 16px;border-radius:10px;background:#edf3fa;color:#41536d;margin:14px 0}.hidden{display:none!important}@media(max-width:680px){.grid{grid-template-columns:1fr}.scene{grid-template-columns:72px 1fr}.scene img{width:72px;height:60px}.scene .remove{grid-column:2}}
</style></head>
<body data-url={hasSupabase ? SUPABASE_URL : ''} data-key={hasSupabase ? SUPABASE_KEY : ''}>
<header class="top"><div class="brand">ACROMA <b>360 EXPERIENCE</b></div><a href="/admin/hub" style="color:#fff;text-decoration:none">← Business Hub</a></header>
<main class="wrap"><div class="head"><div><p class="muted">GESTIÓN DE RECORRIDOS</p><h1>Experiencias 360°</h1><p class="muted">Asocia panorámicas a tus proyectos y publica recorridos virtuales para tus clientes.</p></div><span id="status" class="status">Conectando…</span></div>
<div id="app" class="card">Cargando administrador…</div></main>
<script>
import { createClient } from '@supabase/supabase-js';
const root=document.getElementById('app'), badge=document.getElementById('status');
const sb=createClient(document.body.dataset.url||'',document.body.dataset.key||'');
const params=new URLSearchParams(location.search);const requested=params.get('project');
let projects=[],tour=null,scenes=[];
const h=(tag,cls,text)=>{const n=document.createElement(tag);if(cls)n.className=cls;if(text)n.textContent=text;return n};
const btn=(text,fn,cls='btn')=>{const b=h('button',cls,text);b.type='button';b.onclick=fn;return b};
function field(label,name,type='text',value=''){const w=h('div','field');const l=h('label','',label);const i=h(type==='textarea'?'textarea':'input');if(type!=='textarea')i.type=type;i.name=name;i.value=value||'';w.append(l,i);return w}
async function start(){if(!document.body.dataset.url||!document.body.dataset.key){root.textContent='Faltan las variables públicas de Supabase.';return}const {data:{session}}=await sb.auth.getSession();if(!session){root.replaceChildren(h('h2','','Inicia sesión'));const f=h('form','grid');const em=field('CORREO','email','email'),pw=field('CONTRASEÑA','password','password');const go=btn('Ingresar',async()=>{});go.type='submit';f.append(em,pw,go);f.onsubmit=async e=>{e.preventDefault();const {error}=await sb.auth.signInWithPassword({email:em.querySelector('input').value,password:pw.querySelector('input').value});if(error)alert(error.message);else start()};root.append(f);return}
const {data,error}=await sb.from('hub_projects').select('id,title,project_code,location').order('created_at',{ascending:false});if(error){root.textContent=error.message;return}projects=data||[];const {data:existing}=requested?await sb.from('hub_project_tours').select('*').eq('project_id',requested).maybeSingle():{data:null};tour=existing;await loadScenes();render()}
async function loadScenes(){if(!tour){scenes=[];return}const {data}=await sb.from('hub_project_tour_scenes').select('*').eq('tour_id',tour.id).order('sort_order');scenes=data||[]}
function render(){root.replaceChildren();const form=h('div');const intro=h('div','notice','Cada proyecto puede tener un recorrido. Sube una panorámica equirectangular 360° por ambiente (JPG/PNG/WEBP). El recorrido se activa al publicarlo.');form.append(intro);
const projectWrap=h('div','field');projectWrap.append(h('label','','PROYECTO VINCULADO'));const select=h('select');projects.forEach(p=>{const o=h('option','',p.title+' · '+(p.project_code||''));o.value=p.id;if((tour?.project_id||requested)===p.id)o.selected=true;select.append(o)});projectWrap.append(select);form.append(projectWrap);
const meta=h('div','grid');meta.append(field('TÍTULO DEL RECORRIDO','title','text',tour?.title||'Recorrido virtual'),field('SLUG DEL ENLACE','slug','text',tour?.slug||''),field('PRESENTACIÓN BREVE','intro','textarea',tour?.intro||''));form.append(meta);
const publish=h('div','row');const state=h('span','status '+(tour?.status==='published'?'live':''),tour?.status==='published'?'Publicado':'Borrador');const save=btn(tour?'Guardar configuración':'Crear recorrido',async()=>{save.disabled=true;try{const projectId=select.value;const title=meta.querySelector('[name=title]').value.trim();const slug=meta.querySelector('[name=slug]').value.trim().toLowerCase().replace(/[^a-z0-9-]/g,'-');if(!projectId||!title||!slug)throw new Error('Completa proyecto, título y slug.');const payload={project_id:projectId,title,slug,intro:meta.querySelector('[name=intro]').value,status:tour?.status||'draft',created_by:(await sb.auth.getUser()).data.user.id};const result=tour?await sb.from('hub_project_tours').update(payload).eq('id',tour.id).select().single():await sb.from('hub_project_tours').insert(payload).select().single();if(result.error)throw result.error;tour=result.data;requested||history.replaceState({},'', '?project='+projectId);await loadScenes();render();}catch(e){alert(e.message||'No se pudo guardar')}finally{save.disabled=false}},'btn gold');publish.append(state,save);if(tour){publish.append(btn(tour.status==='published'?'Retirar publicación':'Publicar recorrido',async()=>{const status=tour.status==='published'?'draft':'published';const {error}=await sb.from('hub_project_tours').update({status}).eq('id',tour.id);if(error)alert(error.message);else{tour.status=status;render()}},'btn'));}form.append(publish);
if(tour){const section=h('section','card');section.append(h('h2','','Ambientes y panorámicas'),h('p','muted','Ordena los espacios y asigna cada vista al nivel correspondiente.'));const upload=h('form','grid');const name=field('NOMBRE DEL AMBIENTE','scene_title','text'),floor=field('NIVEL / PLANTA','floor_label','text','Primer piso'),desc=field('DESCRIPCIÓN','description','text'),file=field('PANORÁMICA 360°','panorama','file');file.querySelector('input').accept='image/jpeg,image/png,image/webp';file.classList.add('full');upload.append(name,floor,desc,file);const add=btn('Subir ambiente',async()=>{} ,'btn gold');add.type='submit';upload.append(add);upload.onsubmit=async e=>{e.preventDefault();add.disabled=true;try{const f=file.querySelector('input').files[0];if(!f)throw new Error('Selecciona una panorámica.');if(!['image/jpeg','image/png','image/webp'].includes(f.type)||f.size>50*1024*1024)throw new Error('Usa JPG, PNG o WEBP de máximo 50 MB.');const path=tour.id+'/'+crypto.randomUUID()+'.'+f.name.split('.').pop().toLowerCase();const up=await sb.storage.from('acroma-360').upload(path,f,{contentType:f.type,upsert:false});if(up.error)throw up.error;const url=sb.storage.from('acroma-360').getPublicUrl(path).data.publicUrl;const ins=await sb.from('hub_project_tour_scenes').insert({tour_id:tour.id,title:name.querySelector('input').value.trim(),floor_label:floor.querySelector('input').value.trim()||'Primer piso',description:desc.querySelector('input').value,panorama_url:url,sort_order:scenes.length});if(ins.error)throw ins.error;await loadScenes();render()}catch(e){alert(e.message||'No se pudo subir la panorámica')}finally{add.disabled=false}};section.append(upload);
scenes.forEach(s=>{const row=h('div','scene');const img=h('img');img.src=s.panorama_url;img.alt=s.title;const info=h('div');info.append(h('strong','',s.title),h('div','muted',s.floor_label));row.append(img,info,btn('Eliminar',async()=>{if(!confirm('¿Eliminar este ambiente?'))return;const {error}=await sb.from('hub_project_tour_scenes').delete().eq('id',s.id);if(error)alert(error.message);else{await loadScenes();render()}},'btn light remove'));section.append(row)});if(scenes.length){const share=h('div','notice','Enlace público: '+location.origin+'/recorrido/?tour='+tour.slug);section.append(share,btn('Copiar enlace',()=>navigator.clipboard.writeText(location.origin+'/recorrido/?tour='+tour.slug),'btn light'));}form.append(section)}root.append(form)}
start();
</script></body></html>