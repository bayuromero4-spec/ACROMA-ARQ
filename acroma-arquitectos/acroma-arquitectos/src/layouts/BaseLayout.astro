---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource-variable/playfair-display/index.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import MobileBar from '../components/MobileBar.astro';
import PromoBanner from '../components/PromoBanner.astro';
import { getBusiness } from '../lib/content';
import { organizationSchema, websiteSchema } from '../lib/seo';
import logo from '../assets/logo-acroma.png';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica sin dominio, p. ej. "/servicios". */
  path?: string;
  /** Imagen para Open Graph (URL absoluta o ruta). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** JSON-LD adicional específico de la página. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const business = await getBusiness();
const { title, description, path, ogImage, ogType = 'website', noindex = false, schema } = Astro.props;

const site = Astro.site!.toString().replace(/\/$/, '');
const pathname = path ?? Astro.url.pathname.replace(/\/$/, '') ?? '';
const canonical = pathname === '' || pathname === '/' ? `${site}/` : `${site}${pathname}`;
const fullTitle = pathname === '' || pathname === '/' ? title : `${title} | ${business.name}`;
const logoUrl = `${site}${logo.src}`;
const image = ogImage ?? `${site}/og-default.jpg`;

const jsonLd = [
  organizationSchema(business, site, logoUrl),
  websiteSchema(business, site),
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex,nofollow" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="theme-color" content="#0d1728" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:site_name" content={business.name} />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Datos estructurados -->
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <PromoBanner />
    <Header currentPath={pathname} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <MobileBar />
    <script>
      import '../scripts/effects.ts';
    </script>
  </body>
</html>
