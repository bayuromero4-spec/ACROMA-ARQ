---
import { Image } from 'astro:assets';
import logo from '../assets/logo-acroma.png';
import { navigation } from '../data/site';
import { getBusiness, getServices } from '../lib/content';
import { whatsappUrl } from '../lib/format';

const business = await getBusiness();
const services = await getServices();
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href="/" aria-label="ACROMA Arquitectos, inicio">
        <Image src={logo} alt="" width={44} height={38} loading="lazy" />
        <span>ACR<em>OMA</em></span>
      </a>
      <p>{business.tagline}. Diseñamos y construimos espacios que se entienden antes de construirse.</p>
      <ul class="footer__social" role="list">
        <li><a href={business.social.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
        <li><a href={business.social.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
      </ul>
    </div>

    <nav aria-label="Servicios">
      <h2 class="footer__title">Servicios</h2>
      <ul role="list">
        {services.slice(0, 6).map((s) => <li><a href={`/servicios/${s.slug}`}>{s.title}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Navegación del sitio">
      <h2 class="footer__title">Estudio</h2>
      <ul role="list">
        <li><a href="/">Inicio</a></li>
        {navigation.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="footer__title">Contacto</h2>
      <address>
        <ul role="list">
          {
            business.phones.map((p) => (
              <li>
                <a href={`tel:${p.e164}`}>{p.display}</a>
              </li>
            ))
          }
          <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
          <li>{business.address.locality}, {business.address.country}</li>
          <li>{business.hours}</li>
        </ul>
      </address>
      <a class="footer__wa" href={whatsappUrl(business.whatsapp.e164, 'Hola ACROMA, quiero información sobre un proyecto.')} target="_blank" rel="noopener noreferrer">
        Escribir por WhatsApp
      </a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {year} {business.name}. Todos los derechos reservados.</p>
    <p>Arquitectura, construcción y reformas en Cajamarca, Perú.</p>
  </div>
</footer>

<style>
  .footer {
    background: #090f1b;
    color: rgba(255, 255, 255, 0.66);
    padding-top: clamp(52px, 7vw, 84px);
    font-size: 0.95rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 0.8fr 1.2fr;
    gap: 40px 48px;
    padding-bottom: 52px;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--font-label);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--white);
    margin-bottom: 18px;
  }
  .footer__logo img {
    width: 44px;
    height: auto;
  }
  .footer__logo em {
    font-style: normal;
    color: var(--gold-2);
  }
  .footer__brand p {
    max-width: 34ch;
    line-height: 1.7;
  }
  .footer__social {
    display: flex;
    gap: 18px;
    margin-top: 20px;
  }
  .footer__title {
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 18px;
  }
  .footer ul {
    display: grid;
    gap: 10px;
  }
  .footer address {
    font-style: normal;
  }
  .footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .footer a:hover {
      color: var(--gold-2);
    }
  }
  .footer__wa {
    display: inline-block;
    margin-top: 22px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--gold);
    color: var(--white) !important;
    font-family: var(--font-label);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 32px;
    padding-block: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  @media (max-width: 920px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
