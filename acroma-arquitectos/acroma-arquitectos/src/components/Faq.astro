---
import { faq } from '../data/faq';
---

<section class="section aurora" aria-labelledby="faq-title">
  <div class="container faq">
    <div data-reveal>
      <p class="eyebrow">Preguntas frecuentes</p>
      <h2 id="faq-title">Lo que casi todos nos preguntan.</h2>
      <p class="lead">Si tu duda no está aquí, escríbenos y te respondemos sin compromiso.</p>
    </div>
    <div class="faq__list" data-reveal-group="80">
      {
        faq.map((f) => (
          <details class="faq__item glass">
            <summary>{f.q}<span class="faq__icon" aria-hidden="true"></span></summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .faq .lead {
    margin-top: 20px;
    max-width: 40ch;
  }
  .faq__list {
    display: grid;
    gap: 12px;
  }
  .faq__item {
    --radius-lg: 22px;
    padding: 0 22px;
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    font-family: var(--font-label);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--navy);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    border-radius: 2px;
    background: var(--gold-ink);
    transition: transform 0.35s var(--ease-out);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  details[open] .faq__icon::after {
    transform: rotate(0);
  }
  details p {
    padding: 0 0 22px;
    line-height: 1.75;
    color: var(--soft-ink);
  }
  summary:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
    border-radius: 8px;
  }
  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
