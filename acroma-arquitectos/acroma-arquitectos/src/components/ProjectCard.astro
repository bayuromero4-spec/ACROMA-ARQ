---
import type { Project } from '../data/types';
import { unsplashSrcset } from '../data/images';
import { yearOf } from '../lib/format';

interface Props {
  project: Project;
  ratio?: 'landscape' | 'portrait';
  eager?: boolean;
}
const { project, ratio = 'landscape', eager = false } = Astro.props;
---

<article class:list={['project', `project--${ratio}`]}>
  <a href={`/proyectos/${project.slug}`} class="project__link">
    <div class="project__media">
      <img
        src={project.mainImage.src}
        srcset={unsplashSrcset(project.mainImage.src, [480, 800, 1200])}
        sizes="(min-width: 980px) 380px, (min-width: 640px) 50vw, 100vw"
        width={project.mainImage.width}
        height={project.mainImage.height}
        alt={project.mainImage.alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="project__glass glass glass--dark" data-glass>
        <p class="project__meta">{project.category} · {yearOf(project.date)}</p>
        <h3>{project.title}</h3>
        <p class="project__loc">{project.location}</p>
        <span class="project__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M8 7h9v9" /></svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .project__link {
    display: block;
    text-decoration: none;
  }
  .project__media {
    position: relative;
    aspect-ratio: 4 / 3.3;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #2a3d5c, #14233c);
    box-shadow: 0 20px 50px rgba(20, 35, 60, 0.18);
    transition: box-shadow 0.6s var(--ease-out), transform 0.6s var(--ease-out);
  }
  .project--portrait .project__media {
    aspect-ratio: 4 / 5.6;
  }
  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease-out);
  }
  .project__glass {
    --radius-lg: 22px;
    --glass-bg: linear-gradient(135deg, rgba(13, 23, 40, 0.55), rgba(13, 23, 40, 0.34));
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 16px 62px 16px 20px;
    transition: transform 0.6s var(--ease-out);
  }
  .project__meta {
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-2);
    margin-bottom: 6px;
  }
  h3 {
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    color: var(--white);
  }
  .project__loc {
    margin-top: 4px;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.76);
  }
  .project__arrow {
    position: absolute;
    right: 14px;
    bottom: 14px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: var(--navy-2);
    background: linear-gradient(180deg, #efd99a, #d3b565);
    transition: transform 0.5s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .project__link:hover .project__media {
      transform: translateY(-6px);
      box-shadow: 0 34px 70px rgba(20, 35, 60, 0.28);
    }
    .project__link:hover .project__media img {
      transform: scale(1.07);
    }
    .project__link:hover .project__arrow {
      transform: rotate(45deg);
    }
  }
</style>
