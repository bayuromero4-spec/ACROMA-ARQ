---
import { getActiveCampaign } from '../lib/content';
import { kindLabel } from '../lib/format';

const c = await getActiveCampaign();
const href = c?.ctaUrl || `/novedades/${c?.slug}`;
---

{
  c && (
    <div class="promo" data-promo={c.slug} data-ends={c.endsOn ?? ''}>
      <a class="promo__link" href={href}>
        <span class="promo__tag">{kindLabel(c.kind)}</span>
        <span class="promo__text"><strong>{c.title}</strong>{c.summary ? ` · ${c.summary}` : ''}</span>
        <span class="promo__go" aria-hidden="true">Ver →</span>
      </a>
      <button class="promo__x" type="button" aria-label="Cerrar aviso" data-promo-close>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-promo]');
        if (!el) return;
        var today = new Date();
        var iso = today.getFullYear() + '-' + String(today.getMonth() + 1).padStart(2, '0') + '-' + String(today.getDate()).padStart(2, '0');
        var ends = el.getAttribute('data-ends');
        var closed = false;
        try { closed = sessionStorage.getItem('promo-closed') === el.getAttribute('data-promo'); } catch (e) {}
        if ((ends && ends < iso) || closed) el.remove();
        else el.querySelector('[data-promo-close]').addEventListener('click', function () {
          try { sessionStorage.setItem('promo-closed', el.getAttribute('data-promo')); } catch (e) {}
          el.remove();
        });
      })();
    </script>
  )
}

<style is:global>
  :root {
    --banner-h: 42px;
  }
  .promo {
    position: relative;
    z-index: 210;
    height: var(--banner-h);
    display: flex;
    align-items: center;
    background: linear-gradient(90deg, #bd9850, #e4c37d 50%, #bd9850);
    color: var(--navy-2);
    font-size: 0.92rem;
  }
  .promo__link {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 100%;
    padding: 0 44px;
    text-decoration: none;
    color: inherit;
  }
  .promo__tag {
    flex: none;
    padding: 2px 10px;
    border-radius: 99px;
    background: rgba(13, 23, 40, 0.88);
    color: var(--gold-2);
    font-family: var(--font-label);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .promo__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .promo__go {
    flex: none;
    font-family: var(--font-label);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.78rem;
  }
  .promo__x {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(13, 23, 40, 0.1);
    color: inherit;
    cursor: pointer;
  }
  body:has(.promo) .site-header {
    top: calc(12px + var(--banner-h));
  }
  body:has(.promo) .site-header[data-scrolled] {
    top: 12px;
  }
  @media (max-width: 640px) {
    .promo__go {
      display: none;
    }
    .promo__link {
      padding: 0 40px 0 14px;
      justify-content: flex-start;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: top 0.35s var(--ease-out);
    }
  }
</style>
