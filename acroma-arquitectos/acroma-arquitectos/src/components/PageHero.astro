---
interface Crumb {
  name: string;
  href?: string;
}
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  breadcrumbs?: Crumb[];
}
const { eyebrow, title, lead, breadcrumbs = [] } = Astro.props;
---

<header class="page-hero aurora aurora--dark">
  <div class="container">
    {
      breadcrumbs.length > 0 && (
        <nav class="crumbs glass glass--dark glass--pill rise" aria-label="Migas de pan">
          <ol role="list">
            <li><a href="/">Inicio</a></li>
            {breadcrumbs.map((c) => (
              <li>{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
            ))}
          </ol>
        </nav>
      )
    }
    <p class="eyebrow eyebrow--light rise" style="--d: 100ms">{eyebrow}</p>
    <h1 class="rise" style="--d: 200ms">{title}</h1>
    {lead && <p class="page-hero__lead rise" style="--d: 340ms">{lead}</p>}
  </div>
</header>

<style>
  .page-hero {
    background:
      linear-gradient(90deg, rgba(189, 152, 80, 0.08) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(160deg, var(--navy-2), var(--navy));
    color: var(--white);
    padding-top: calc(var(--header-h) + 28px + clamp(36px, 6vw, 72px));
    padding-bottom: clamp(48px, 7vw, 84px);
  }
  h1 {
    max-width: 18ch;
    font-size: clamp(2.3rem, 5.4vw, 4.2rem);
    line-height: 1.03;
    letter-spacing: -0.012em;
    color: var(--white);
    font-weight: 800;
  }
  .page-hero__lead {
    margin-top: 22px;
    max-width: 60ch;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.74);
  }
  .crumbs {
    display: inline-block;
    margin-bottom: 30px;
    padding: 9px 20px;
    --glass-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 6px;
    color: rgba(255, 255, 255, 0.35);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs [aria-current] {
    color: var(--gold-2);
  }
  @media (hover: hover) and (pointer: fine) {
    .crumbs a:hover {
      color: var(--white);
    }
  }
</style>
