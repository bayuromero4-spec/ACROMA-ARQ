---
import type { Post } from '../data/types';
import { formatDay, kindLabel } from '../lib/format';

interface Props {
  post: Post;
}
const { post } = Astro.props;
---

<article class="post glass" data-glass>
  <a class="post__link" href={`/novedades/${post.slug}`}>
    <div class="post__media">
      {
        post.image ? (
          <img src={post.image.src} alt={post.image.alt} width={post.image.width} height={post.image.height} loading="lazy" decoding="async" />
        ) : (
          <div class="post__ph" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V9l8-5 8 5v11M9 20v-6h6v6" /></svg>
          </div>
        )
      }
      <span class:list={['post__kind', 'glass', 'glass--pill', post.kind === 'campana' && 'post__kind--gold']}>{kindLabel(post.kind)}</span>
    </div>
    <div class="post__body">
      <p class="post__date">{formatDay(post.startsOn)}{post.endsOn && post.kind === 'campana' ? ` · hasta el ${formatDay(post.endsOn)}` : ''}</p>
      <h3>{post.title}</h3>
      <p class="post__text">{post.summary}</p>
      <span class="post__more">Ver más →</span>
    </div>
  </a>
</article>

<style>
  .post {
    height: 100%;
    padding: 10px;
    transition: transform 0.6s var(--ease-out), box-shadow 0.6s var(--ease-out);
  }
  .post__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }
  .post__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #1b2f52, #0d1728);
  }
  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease-out);
  }
  .post__ph {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--gold-2);
    background:
      radial-gradient(circle at 70% 20%, rgba(189, 152, 80, 0.35), transparent 55%),
      linear-gradient(135deg, #1b2f52, #0d1728);
  }
  .post__kind {
    position: absolute;
    left: 12px;
    top: 12px;
    padding: 6px 14px;
    font-family: var(--font-label);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--white);
    --glass-bg: linear-gradient(135deg, rgba(13, 23, 40, 0.62), rgba(13, 23, 40, 0.42));
  }
  .post__kind--gold {
    color: var(--navy-2);
    --glass-bg: linear-gradient(135deg, rgba(228, 195, 125, 0.95), rgba(189, 152, 80, 0.9));
  }
  .post__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 14px 14px;
  }
  .post__date {
    margin-bottom: 8px;
    font-size: 0.84rem;
    color: var(--muted);
  }
  h3 {
    margin-bottom: 10px;
  }
  .post__text {
    font-size: 0.96rem;
    line-height: 1.7;
    color: var(--soft-ink);
  }
  .post__more {
    margin-top: auto;
    padding-top: 18px;
    font-family: var(--font-label);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
  }
  @media (hover: hover) and (pointer: fine) {
    .post:hover {
      transform: translateY(-8px);
      --glass-shadow: 0 30px 70px rgba(20, 35, 60, 0.22);
    }
    .post:hover .post__media img {
      transform: scale(1.06);
    }
  }
</style>
